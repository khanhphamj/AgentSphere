# ============================================================
# AgentSphere — environment configuration
# Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# ---- Internal service-to-service credentials (OAuth-style client) ----
# Used by the gateway / orchestrator to authenticate against internal services.
CLIENT_ID=
CLIENT_SECRET=

# ---- LLM provider: GreenNode Model-as-a-Service (OpenAI-compatible) ----
# Get an API key from the GreenNode AI Platform Portal:
#   https://aiplatform.console.greennode.ai/api-keys
# Models are addressed as "org/model-name" (e.g. deepseek-ai/DeepSeek-R1).
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
# auto  = call the real endpoint, fall back to simulation on failure
# on    = always simulate (offline demo)
# off   = real calls only, errors surface
LLM_SIMULATION=auto

# ---- Auth (gateway) ----
# Sign-in uses Google Authenticator TOTP (RFC 6238): first login shows a QR
# to enroll, then the 6-digit app code is required. Users live in Postgres
# (docker compose service "db"); without it the gateway degrades to an
# in-memory store. Set AUTH_ACCEPT_ANY_CODE=true to accept any 6 digits (demo).
AUTH_ACCEPT_ANY_CODE=false
DATABASE_URL=postgres://agentsphere:agentsphere@localhost:5433/agentsphere
JWT_TTL_HOURS=72

# ---- Service ports ----
GATEWAY_PORT=8080
ORCHESTRATOR_PORT=8081
AGENT_RUNTIME_PORT=8082
MCP_POLICY_PORT=8083

# ---- Internal URLs (override for docker-compose networking) ----
ORCHESTRATOR_URL=http://localhost:8081
AGENT_RUNTIME_URL=http://localhost:8082
MCP_POLICY_URL=http://localhost:8083

# ---- Agent long-term memory: GreenNode AgentBase Memory Service ----
# Optional. Leave blank to run on the local JSON mirror (default; no behavior change).
# Set AGENTBASE_MEMORY=off to force local-only even if creds are present.
AGENTBASE_MEMORY=auto
# A GreenNode IAM service account (https://iam.console.vngcloud.vn/service-accounts).
# NOTE: depending on your setup these MAY be the same values as CLIENT_ID/CLIENT_SECRET above.
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
# Created by `npm run memory:provision` — paste the printed IDs here, then `npm run memory:health`.
MEMORY_ID=
MEMORY_STRATEGY_ID=
# Optional endpoint overrides (defaults target the VNG Cloud HCM region):
# IAM_TOKEN_URL=https://iam.api.vngcloud.vn/accounts-api/v2/auth/token
# MEMORY_BASE_URL=https://agentbase.api.vngcloud.vn/memory
